# Optional for local development — leave unset to keep Desk open without login.
# Required for a hosted deploy (e.g. Vercel / Cursor publish).

DESK_PASSWORD=choose-a-strong-password
DESK_SESSION_SECRET=replace-with-a-long-random-string

# Cursor Cloud Agents API — user API key from
# https://cursor.com/dashboard → Integrations / API Keys
# Do NOT use CURSOR_* names (reserved by the publish host).
DESK_CURSOR_API_KEY=
