# Optional for local development — leave unset to keep Desk open without login.
# Required for a hosted deploy (e.g. Vercel / Cursor publish).

DESK_PASSWORD=choose-a-strong-password
DESK_SESSION_SECRET=replace-with-a-long-random-string

# Cursor Cloud Agents API — user API key from
# https://cursor.com/dashboard → Integrations / API Keys
# Do NOT use CURSOR_* names (reserved by the publish host).
DESK_CURSOR_API_KEY=

# Optional: protect POST /api/sync/import (desk-push --post, Desk Sync extension, Shortcuts)
DESK_IMPORT_TOKEN=

# Optional: extra CORS Origins for /api/sync/import (comma-separated).
# chrome-extension:// and localhost are already allowed.
# DESK_CORS_ORIGINS=https://desk.example.com


# Claude Enterprise Compliance Access Key (NOT a consumer API key).
# Lists claude.ai chats: GET /v1/compliance/apps/chats
# https://platform.claude.com/docs/en/api/compliance/apps/chats/list
# Consumers: import ~/.claude/projects/**/*.jsonl instead (Connect file drop).
DESK_ANTHROPIC_COMPLIANCE_KEY=

# ChatGPT Enterprise / Edu Compliance API (NOT a regular OpenAI API key).
# https://api.chatgpt.com/v1/compliance/workspaces/{id}/conversations
# Consumers: import ~/.codex/sessions/**/rollout-*.jsonl instead.
DESK_OPENAI_COMPLIANCE_KEY=
DESK_OPENAI_WORKSPACE_ID=
